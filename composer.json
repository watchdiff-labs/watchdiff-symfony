{
    "name": "watchdiff-labs/watchdiff-symfony",
    "description": "Symfony bundle for watchdiff-core - web change monitoring with Symfony Console integration.",
    "type": "symfony-bundle",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/watchdiff-labs/watchdiff-symfony",
    "support": {
        "issues": "https://github.com/watchdiff-labs/watchdiff-symfony/issues",
        "source": "https://github.com/watchdiff-labs/watchdiff-symfony"
    },
    "keywords": [
        "watchdiff",
        "symfony",
        "monitoring",
        "diff",
        "change-detection"
    ],
    "require": {
        "php": "^8.1",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "watchdiff-labs/watchdiff-core": "^0.1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "friendsofphp/php-cs-fixer": "^3.57",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "WatchDiff\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WatchDiff\\Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
